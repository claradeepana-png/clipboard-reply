# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Model (can be changed in app)
DEFAULT_MODEL=openai/gpt-3.5-turbo

# Hotkey to activate (e.g., ctrl+shift+r, alt+r, etc.)
HOTKEY=ctrl+shift+r

